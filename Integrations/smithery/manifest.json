{
  "manifest_version": "0.3",
  "name": "tethered",
  "display_name": "Tethered Task Sessions",
  "version": "0.2.7",
  "description": "Use saved Tethered profiles for local AI work on Apple Silicon Macs.",
  "long_description": "Requires an Apple Silicon Mac running macOS 15 or later, Tethered 1.2.0 or later installed and running under the same macOS account, Pro access, and AI task sessions enabled. Discover saved task profiles, request power modes and keep-awake behavior, and inspect or end owned sessions. Profile-controlled background app policies and task safeguards remain subject to user settings. Unlimited profiles require an explicit end. This adapter runs locally over stdio; cloud-only clients and Intel Macs are unsupported. The bundle contains no connection credentials or saved profiles.",
  "author": {
    "name": "Tumerit",
    "url": "https://tumerit.com"
  },
  "homepage": "https://tetheredmac.com",
  "documentation": "https://github.com/Tumerit/Tethered/tree/main/Integrations",
  "support": "https://github.com/Tumerit/Tethered/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tumerit/Tethered"
  },
  "icon": "icon.png",
  "compatibility": {
    "platforms": [
      "darwin"
    ]
  },
  "server": {
    "type": "binary",
    "entry_point": "server/tethered-mcp",
    "mcp_config": {
      "command": "${__dirname}/server/tethered-mcp",
      "args": []
    }
  },
  "keywords": [
    "macos",
    "apple-silicon",
    "power-management",
    "local",
    "task-sessions"
  ],
  "tools": [
    {
      "description": "List saved temporary task profiles and duration limits.",
      "name": "list_task_profiles",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "power_mode": {
                  "type": "string"
                },
                "caffeinate_preset_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "maximum_minutes": {
                  "type": "integer"
                },
                "keep_awake": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "maximum_minutes"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "profiles"
        ],
        "additionalProperties": true
      }
    },
    {
      "description": "Start one temporary task session using a saved profile for power mode, display brightness, fan control, keep-awake, and optional process priority or suspension policies. The user configures policies and exceptions in Tethered. Automatic modes protect the detected AI client and its descendants; separate model services need exceptions. Suspension does not purge memory. End it according to the user's ending preference. Finite sessions expire automatically; unlimited sessions require an explicit end.",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile_id"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 200,
            "description": "Short user-visible reason for this task session; do not include sensitive prompt content."
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60,
            "description": "Requested session duration in minutes, capped by the saved profile. Zero requests an unlimited session only when the profile allows it; an unlimited session requires an explicit end."
          },
          "profile_id": {
            "type": "string",
            "description": "ID of the user-selected saved profile returned by list_task_profiles."
          }
        }
      },
      "name": "begin_task",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "active"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "profile_name": {
            "type": "string"
          },
          "brightness": {
            "type": "string"
          },
          "power_override_owned": {
            "type": "boolean"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "fans": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "keep_awake": {
            "type": "boolean"
          },
          "resources": {
            "additionalProperties": true,
            "type": "object"
          },
          "power_mode": {
            "type": "string"
          },
          "safeguards": {
            "additionalProperties": true,
            "type": "object"
          },
          "caffeinate_preset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "disk_cache_purge": {
            "additionalProperties": true,
            "type": "object"
          },
          "process_management": {
            "additionalProperties": true,
            "type": "object"
          },
          "power_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    {
      "inputSchema": {
        "type": "object",
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Exact ID of the session owned by this chat; do not adopt another chat's session."
          }
        },
        "additionalProperties": false
      },
      "description": "Release the specified task session and request normal power policy. Manual changes are preserved.",
      "name": "end_task",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false
      },
      "outputSchema": {
        "properties": {
          "ended": {
            "type": "boolean"
          },
          "restoration": {
            "type": "string"
          }
        },
        "required": [
          "ended",
          "restoration"
        ],
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "description": "Only on an explicit user request to clear all task sessions: end the active session regardless of which chat started it and request normal policy. Takes no arguments. Idempotent when inactive.",
      "name": "clear_task_sessions",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "cleared_count",
          "active",
          "restoration"
        ],
        "additionalProperties": true,
        "properties": {
          "restoration": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "cleared_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "name": "purge_disk_cache",
      "description": "Manual-only global disk-cache purge, solely on an explicit user request. Never automate per prompt or on memory pressure. Includes the AI workload\u2019s disk cache; cannot purge private RAM selectively or save and restore model caches. Returns a pending operation for native confirmation and administrator authorization. Inspect disk_cache_purge in get_session_status before retrying.",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false
      },
      "outputSchema": {
        "properties": {
          "phase": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "phase",
          "operation_id",
          "message",
          "scope"
        ],
        "type": "object"
      }
    },
    {
      "description": "Report intermediate activity for this chat's owned active task. Send tool_started before a call and tool_succeeded or tool_failed afterward; provide stable input text for repetition matching. Send assistant_output, explicit progress, files_changed, or heartbeat as appropriate. Each event needs a new UUID; retry with the same event UUID. Input/output are bounded to 8192 UTF-8 bytes each. Reports are unverified client observations and never automatically captured. Inspect the returned disposition; pause/cancellation are client requests, not process actions. Do not fabricate progress or report another chat's events.",
      "inputSchema": {
        "required": [
          "session_id",
          "event_id",
          "kind"
        ],
        "properties": {
          "input": {
            "maxLength": 8192,
            "type": "string",
            "description": "Stable tool input or activity text for repetition matching, bounded to 8192 UTF-8 bytes."
          },
          "event_id": {
            "type": "string",
            "description": "Unique UUID for this event. Reuse the same UUID when retrying this event."
          },
          "kind": {
            "enum": [
              "tool_started",
              "tool_succeeded",
              "tool_failed",
              "assistant_output",
              "progress",
              "files_changed",
              "heartbeat"
            ],
            "type": "string",
            "description": "Type of observed activity being reported for the owned session."
          },
          "output": {
            "type": "string",
            "maxLength": 8192,
            "description": "Observed tool output or activity result, bounded to 8192 UTF-8 bytes."
          },
          "tool": {
            "type": "string",
            "maxLength": 256,
            "description": "Name of the tool associated with this event, when applicable."
          },
          "session_id": {
            "type": "string",
            "description": "Exact ID of the session owned by this chat; do not adopt another chat's session."
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "name": "report_task_event",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "monitoring": {
            "type": "boolean"
          },
          "intervention": {
            "type": "string"
          },
          "configuration": {
            "additionalProperties": true,
            "type": "object"
          },
          "progress_ages_seconds": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "seconds_since_event": {
            "type": [
              "number",
              "null"
            ]
          },
          "event_delivery": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "additionalProperties": true,
              "type": "object"
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "continue",
              "pause_requested",
              "cancel_requested"
            ]
          },
          "received_events": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "monitoring",
          "disposition",
          "warnings"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "acknowledge_task_safeguards",
      "inputSchema": {
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Exact ID of the session owned by this chat; do not adopt another chat's session."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ]
      },
      "description": "Only after the user explicitly chooses to continue or dismiss safeguards for this chat's owned active session: clear warnings and repetition history, reset event/progress timers, and clear pending client pause/cancellation requests. Does not extend the session, change rules, or restart cancelled work.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false
      },
      "outputSchema": {
        "properties": {
          "received_events": {
            "minimum": 0,
            "type": "integer"
          },
          "event_delivery": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "continue",
              "pause_requested",
              "cancel_requested"
            ],
            "type": "string"
          },
          "progress_ages_seconds": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          },
          "seconds_since_event": {
            "type": [
              "number",
              "null"
            ]
          },
          "intervention": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "monitoring": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "monitoring",
          "disposition",
          "warnings"
        ],
        "additionalProperties": true
      }
    },
    {
      "description": "Get the active task session, expiration, requested controls, and local memory pressure, physical RAM, swap usage, and task safeguard warnings and requested client disposition. Resources are reported even without an active session. Power controls describe requests, not measured hardware state. This tool does not modify processes or reclaim memory.",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object",
        "properties": {}
      },
      "name": "get_session_status",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "active"
        ],
        "additionalProperties": true,
        "properties": {
          "resources": {
            "type": "object",
            "additionalProperties": true
          },
          "profile_name": {
            "type": "string"
          },
          "power_status": {
            "type": "string"
          },
          "keep_awake": {
            "type": "boolean"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "disk_cache_purge": {
            "type": "object",
            "additionalProperties": true
          },
          "profile_id": {
            "type": "string"
          },
          "brightness": {
            "type": "string"
          },
          "caffeinate_preset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "fans": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "power_override_owned": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "power_mode": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "process_management": {
            "type": "object",
            "additionalProperties": true
          },
          "safeguards": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
